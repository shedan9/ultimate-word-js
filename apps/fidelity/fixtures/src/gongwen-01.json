    {
      "text": "关于进一步加强文档排版引擎保真度验证工作的通知",
      "fontEA": "黑体",
      "fontLatin": "Times New Roman",
      "sizePt": 22,
      "bold": false,
      "align": "center",
      "firstLineChars": 0,
      "spaceBeforePt": 0,
