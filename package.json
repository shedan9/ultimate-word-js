{
  "name": "ultimate-word-js",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "自研布局引擎的 Word（OOXML）在线预览 / 编辑库",
  "license": "MIT",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "truth": "pnpm --filter @uw/fidelity run truth"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/node": "^24.13.3",
    "turbo": "^2.10.9",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
